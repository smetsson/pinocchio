{
  "name": "pinocchio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:emu": "node scripts/dev-emulator.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "rules": "node scripts/build-rules.mjs",
    "test": "vitest run",
    "test:rules": "node scripts/with-emulator.mjs \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "node scripts/with-emulator.mjs \"playwright test\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "firebase": "^12.19.0",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
